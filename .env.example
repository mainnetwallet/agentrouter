# ---------------------------------------------------------------------------
# AgentRouter bridge configuration (all optional).
#
# The bridge is stateless: clients pass their own AgentRouter API key in the
# Authorization header. There is no server-side key except for the optional
# public model list (see AGENTROUTER_MODELS_API_KEY).
# ---------------------------------------------------------------------------

# Upstream AgentRouter API base URL. Override this if AgentRouter changes its
# API host or you are pointing at a staging/mirror endpoint.
# This is the value shown in the official AgentRouter docs and used by Codex CLI
# and Claude Code. Routes are appended like this:
#   OpenAI-compatible : <base>/models, <base>/chat/completions   (base already ends in /v1)
#   Anthropic         : <base>/messages                          (same, /v1 is part of the base)
# Both spellings work - a trailing /v1 is stripped once and never doubled:
#   https://agentrouter.org/v1  ==  https://agentrouter.org
# Default: https://agentrouter.org/v1
AGENTROUTER_BASE_URL=https://agentrouter.org/v1

# Upstream request timeout in milliseconds. Covers connection + response
# headers, and the body read for non-streaming responses. Streaming responses
# use it as an idle timeout between chunks.
# Default: 30000
AGENTROUTER_TIMEOUT_MS=30000

# Port for the Node/Render server. Render sets this automatically.
# Default: 3000
PORT=3000

# Cloudflare Worker only: server-side key used to serve the public
# /api/models model list on the landing page. Leave unset to disable that
# endpoint. NEVER commit a real key to this file.
# AGENTROUTER_MODELS_API_KEY=
